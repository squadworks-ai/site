---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = t(lang).how;

const variants: Record<string, { box: string; tag: string; title: string; text: string; foot: string }> = {
  dark: {
    box: 'rounded-xl bg-ink text-ground',
    tag: 'text-frame-muted',
    title: '',
    text: 'text-frame-muted',
    foot: 'border-frame-line text-amber-bright',
  },
  soon: {
    box: 'rounded-xl border border-dashed border-line bg-card',
    tag: 'text-amber',
    title: 'text-muted',
    text: 'text-muted',
    foot: 'border-line text-muted',
  },
};
---

<section id="como" class="wrap flex flex-col gap-10 pb-24 md:pb-32">
  <div class="flex max-w-[820px] flex-col gap-3.5">
    <p class="eyebrow text-amber">{h.eyebrow}</p>
    <h2 class="h2">{h.title}</h2>
  </div>

  <div class="flex flex-col gap-4">
    <p class="label text-muted">{h.doorsLabel}</p>
    <ol class="grid grid-cols-1 gap-5 md:grid-cols-2" role="list">
      {
        h.doors.map((d) => (
          <li class="card flex min-h-[320px] flex-col gap-3.5 p-7">
            <span class="label text-amber">{d.tag}</span>
            <strong class="text-[26px] font-semibold tracking-[-0.01em]">{d.title}</strong>
            <p class="border-l-2 border-amber pl-3.5 font-mono text-[13px] leading-[1.55] text-ink">{d.quote}</p>
            <p class="text-[15px] leading-[1.55] text-muted">{d.text}</p>
            <span class="label mt-auto border-t border-line pt-3 text-ink">{d.foot}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="flex flex-col gap-4">
    <p class="label text-muted">{h.outputsLabel}</p>
    <ol class="grid grid-cols-1 gap-5 md:grid-cols-2" role="list">
      {
        h.outputs.map((o) => {
          const v = variants[o.variant];
          return (
            <li class={`${v.box} flex min-h-[260px] flex-col gap-3.5 p-7`}>
              <span class={`label ${v.tag}`}>{o.tag}</span>
              <strong class={`text-[26px] font-semibold tracking-[-0.01em] ${v.title}`}>{o.title}</strong>
              <p class={`text-[15px] leading-[1.55] ${v.text}`}>{o.text}</p>
              <span class={`label mt-auto border-t pt-3 ${v.foot}`}>{o.foot}</span>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
