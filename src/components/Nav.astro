---
import Mark from './Mark.astro';
import { t, localePath, otherLang, mailto, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Caminho desta página em cada idioma, para a troca de idioma (padrão: página inicial). */
  paths?: Record<Lang, string>;
}
const { lang, paths = localePath } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
const home = localePath[lang];
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-ground/85 backdrop-blur-md">
  <div class="wrap flex items-center justify-between gap-3 py-3 md:gap-6 md:py-4">
    <a href={localePath[lang]} class="flex shrink-0 items-center gap-2.5" aria-label="Squadworks">
      <Mark size={26} />
      <span class="text-[14px] font-bold tracking-[0.14em] md:text-[15px]">SQUADWORKS</span>
    </a>

    <nav class="hidden items-center gap-7 text-[14px] whitespace-nowrap text-muted lg:flex" aria-label={lang === 'pt-br' ? 'Seções' : 'Sections'}>
      <a href={`${home}#problema`} class="hover:text-ink">{s.nav.problem}</a>
      <a href={`${home}#como`} class="hover:text-ink">{s.nav.how}</a>
      <a href={`${home}#fabrica`} class="hover:text-ink">{s.nav.factory}</a>
      <a href={`${home}#exemplo`} class="hover:text-ink">{s.nav.example}</a>
      <a href={`${home}#sobre`} class="hover:text-ink">{s.nav.about}</a>
    </nav>

    <div class="flex shrink-0 items-center gap-3 md:gap-3.5">
      <a
        href={paths[other]}
        data-lang-switch={other}
        hreflang={other === 'en' ? 'en' : 'pt-BR'}
        aria-label={s.nav.switchLabel}
        class="font-mono text-[12px] tracking-[0.08em] whitespace-nowrap text-muted hover:text-ink"
      >
        <span class="font-medium text-ink">{s.nav.current}</span> / {s.nav.switchShort}
      </a>
      <a href={mailto(lang)} class="btn min-h-[44px] px-4 md:min-h-[48px] md:px-[22px]">{s.nav.cta}</a>
    </div>
  </div>
</header>
